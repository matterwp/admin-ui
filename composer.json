{
	"name": "matterwp/admin-ui",
	"version": "1.2.0",
	"description": "Reusable MatterWP admin UI helpers and styles for WordPress plugins.",
	"type": "library",
	"keywords": [
		"wordpress",
		"admin",
		"ui",
		"matterwp"
	],
	"homepage": "https://github.com/matterwp/admin-ui",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "MatterWP",
			"homepage": "https://matterwp.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/matterwp/admin-ui/issues",
		"source": "https://github.com/matterwp/admin-ui"
	},
	"autoload": {
		"psr-4": {
			"MTWP\\ADMIN\\V120\\": "src/"
		}
	},
	"require": {
		"php": ">=7.3.5"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2"
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
